---
import Layout from '../layouts/Layout.astro';
import { getRecentTweets } from '../lib/x-api';
import type { Tweet } from '../lib/x-api';

let tweets: Tweet[] = [];
try {
  tweets = await getRecentTweets(8);
} catch {
  // X API not configured or rate-limited — show nothing
}

function timeAgo(timestamp: string): string {
  const ms = Date.now() - new Date(timestamp).getTime();
  const mins = Math.floor(ms / 60000);
  if (mins < 1) return 'just now';
  if (mins < 60) return `${mins}m ago`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return `${hrs}h ago`;
  const days = Math.floor(hrs / 24);
  return `${days}d ago`;
}
---

<Layout title="No No Jinx — The MLB No-Hitter Jinx Agent">
  <main>
    <section class="hero">
      <div class="hero-text">
        <h1>NO NO<br/><span class="red">JINX</span></h1>
        <p class="subtitle">Pitcher's got a big butt.</p>
        <p class="desc">
          An AI agent that watches every MLB game, waits for a no-hitter,
          and immediately tells everyone about it. Because talking about
          a no-hitter is the fastest way to kill one.
        </p>
        <a href="https://x.com/nono_jinx" target="_blank" rel="noopener" class="follow">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          Follow @nono_jinx
        </a>
      </div>
    </section>

    <section class="how">
      <div class="how-grid">
        <div class="how-item">
          <h2>We watch.</h2>
          <p>Every pitch. Every game. Every day. The moment a pitcher
          has zero hits allowed, we know about it.</p>
        </div>
        <div class="how-item">
          <h2>We talk.</h2>
          <p>We post about it. Loudly. By name. "Hey, nice no-hitter
          you've got going there. Would be a shame if someone... mentioned it."</p>
        </div>
        <div class="how-item">
          <h2>It works.</h2>
          <p>Every superstitious baseball fan knows: you don't talk about
          a no-hitter. We do. That's the whole thing.</p>
        </div>
      </div>
    </section>

    <section class="quote">
      <blockquote>
        "Did he just say<br/>'funky butt-lovin'?'"
      </blockquote>
    </section>

    <section class="what">
      <h2>What triggers a jinx</h2>
      <div class="triggers">
        <div class="trigger">
          <h3>No-hitter in progress</h3>
          <p>We call it out every inning. Louder each time.</p>
        </div>
        <div class="trigger">
          <h3>No-hitter broken</h3>
          <p>First hit lands. We take full credit.</p>
        </div>
        <div class="trigger">
          <h3>Pitcher replaced</h3>
          <p>New arm, same jinx. Combined no-hitter? Still watching.</p>
        </div>
        <div class="trigger">
          <h3>No-hitter survives</h3>
          <p>If one actually makes it? Respect. Then we reload.</p>
        </div>
      </div>
    </section>

    {tweets.length > 0 && (
      <section class="feed">
        <h2>Recent jinxes</h2>
        <div class="feed-list">
          {tweets.map((tweet) => (
            <a href={`https://x.com/nono_jinx/status/${tweet.id}`} target="_blank" rel="noopener" class="feed-item">
              <div class="feed-meta">
                <span class="feed-handle">@nono_jinx</span>
                <span class="feed-time">{timeAgo(tweet.created_at)}</span>
              </div>
              <p class="feed-text">{tweet.text}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <footer>
      <span class="footer-mark">NO NO JINX</span>
      <nav>
        <a href="https://x.com/nono_jinx" target="_blank" rel="noopener">𝕏</a>
        <a href="https://github.com/sean-cedar/nono-jinx" target="_blank" rel="noopener">GitHub</a>
      </nav>
    </footer>
  </main>
</Layout>

<style>
  main {
    max-width: 880px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .red { color: var(--red); }

  /* ─── HERO ─── */
  .hero {
    padding: 8rem 0 6rem;
  }

  .hero-text {
    max-width: 600px;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 12vw, 7rem);
    line-height: 0.88;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .subtitle {
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    color: var(--gray);
    margin-bottom: 2.5rem;
    font-style: italic;
  }

  .desc {
    font-size: 1.2rem;
    line-height: 1.7;
    color: #333;
    margin-bottom: 2.5rem;
    max-width: 520px;
  }

  .follow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--white);
    background: var(--black);
    padding: 0.75rem 1.5rem;
    border-radius: 100px;
    transition: background 0.15s, transform 0.1s;
  }

  .follow:hover {
    background: #333;
    transform: translateY(-1px);
  }

  .follow:active {
    transform: translateY(0);
  }

  .follow svg {
    flex-shrink: 0;
  }

  /* ─── HOW ─── */
  .how {
    padding: 5rem 0;
    border-top: 1px solid var(--light-gray);
  }

  .how-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
  }

  @media (max-width: 640px) {
    .how-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .how-item h2 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    margin-bottom: 0.5rem;
  }

  .how-item p {
    font-size: 1rem;
    color: #555;
    line-height: 1.65;
  }

  /* ─── QUOTE ─── */
  .quote {
    padding: 5rem 0;
    border-top: 1px solid var(--light-gray);
    text-align: center;
  }

  blockquote {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.5rem);
    line-height: 1.25;
    color: var(--red);
  }

  /* ─── WHAT ─── */
  .what {
    padding: 5rem 0;
    border-top: 1px solid var(--light-gray);
  }

  .what h2 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    margin-bottom: 2rem;
  }

  .triggers {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 3rem;
  }

  @media (max-width: 640px) {
    .triggers {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  .trigger h3 {
    font-family: var(--font-display);
    font-size: 0.95rem;
    margin-bottom: 0.25rem;
  }

  .trigger p {
    font-size: 0.95rem;
    color: #555;
    line-height: 1.55;
  }

  /* ─── FEED ─── */
  .feed {
    padding: 5rem 0;
    border-top: 1px solid var(--light-gray);
  }

  .feed h2 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    margin-bottom: 2rem;
  }

  .feed-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .feed-item {
    display: block;
    padding: 1.25rem;
    border: 1px solid var(--light-gray);
    border-radius: 6px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, background 0.15s;
  }

  .feed-item:hover {
    border-color: var(--gray);
    background: rgba(0, 0, 0, 0.015);
  }

  .feed-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .feed-handle {
    font-family: var(--font-display);
    font-size: 0.75rem;
    color: var(--black);
  }

  .feed-time {
    font-size: 0.75rem;
    color: var(--gray);
  }

  .feed-text {
    font-size: 1rem;
    line-height: 1.5;
  }

  /* ─── FOOTER ─── */
  footer {
    padding: 3rem 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--light-gray);
  }

  .footer-mark {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--gray);
  }

  footer nav {
    display: flex;
    gap: 1.5rem;
  }

  footer nav a {
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--gray);
    transition: color 0.15s;
  }

  footer nav a:hover {
    color: var(--black);
  }
</style>
