---
import Layout from '../layouts/Layout.astro';
import { isAuthenticated } from '../lib/auth';
import AdminPanel from '../components/AdminPanel';

const authed = isAuthenticated(Astro.request);
---

<Layout title="No No Jinx Admin">
  <div class="admin-wrapper">
    <header class="admin-header">
      <a href="/" class="admin-back">← No No Jinx</a>
      <h1>Admin</h1>
    </header>
    {authed ? (
      <AdminPanel client:load />
    ) : (
      <div class="login-wrapper">
        <form id="login-form" class="login-form">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="Enter admin password" autocomplete="current-password" required />
          <button type="submit">Sign In</button>
          <p id="login-error" class="login-error" style="display:none"></p>
        </form>
      </div>
    )}
  </div>
</Layout>

<script>
  const form = document.getElementById('login-form') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const pw = (document.getElementById('password') as HTMLInputElement).value;
      const errEl = document.getElementById('login-error')!;
      errEl.style.display = 'none';

      const res = await fetch('/api/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: pw }),
      });

      if (res.ok) {
        window.location.reload();
      } else {
        errEl.textContent = 'Invalid password';
        errEl.style.display = 'block';
      }
    });
  }
</script>

<style>
  .admin-wrapper {
    min-height: 100vh;
    background: var(--black);
    color: var(--white);
    padding: 2rem 1.5rem;
  }

  .admin-header {
    max-width: 720px;
    margin: 0 auto 2rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .admin-back {
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--gray);
    transition: color 0.15s;
  }

  .admin-back:hover {
    color: var(--white);
  }

  .admin-header h1 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    letter-spacing: 0.05em;
    color: var(--red);
  }

  .login-wrapper {
    max-width: 320px;
    margin: 8rem auto;
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .login-form label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--gray);
  }

  .login-form input {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.7rem 0.8rem;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 2px;
    color: var(--white);
    outline: none;
  }

  .login-form input:focus {
    border-color: var(--red);
  }

  .login-form button {
    font-family: var(--font-display);
    font-size: 0.85rem;
    padding: 0.7rem;
    background: var(--red);
    color: var(--white);
    border: none;
    border-radius: 2px;
    cursor: pointer;
  }

  .login-error {
    color: var(--red);
    font-size: 0.85rem;
    text-align: center;
  }
</style>
